MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_EXPIRES_IN_AZURE=15d

CLIENT_URL=http://localhost:5173
PORT=5000
ENABLE_REMINDER_JOBS=false

AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=

# App-only Graph credentials used solely for sending reminder emails as SENDER_EMAIL
# (separate app registration/permissions from the interactive AZURE_AD_* SSO above).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TENANT_ID=
SENDER_EMAIL=

TRUSTED_EMAIL_DOMAIN=

STORAGE_ACCOUNT_NAME=
STORAGE_ACCOUNT_KEY=
STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER_NAME=

# VMS — visitor OTP delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# HRMS — shared secret the biometric attendance device connector (e.g. the
# eSSL/ZKTeco iClock ADMS connector) sends as X-Api-Key when POSTing punches
# to /api/hrms/attendance/punch. Leave unset to disable that endpoint.
HRMS_DEVICE_API_KEY=

# LMS — Anthropic (Claude) API key used to auto-generate skill test question
# pools. This is a console.anthropic.com API key with its own pay-as-you-go
# billing, NOT a claude.ai subscription. Leave unset to disable the
# "Generate Test" action on the Skills page.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
